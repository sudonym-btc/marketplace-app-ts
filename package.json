{
  "name": "@sudonym-btc/marketplace-app-ts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Nostr marketplace web app with NIP-46 login, listings, orders, inbox, and EVM checkout driver.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "stack:up": "npm --prefix ../.. run up",
    "stack:down": "npm --prefix ../.. run down",
    "up": "npm run stack:up && npm run dev",
    "down": "npm run stack:down",
    "routes:generate": "tsr generate",
    "build": "npm run routes:generate && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run routes:generate && tsc -b && tsc -p tsconfig.arbiter.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@sudonym-btc/marketplace-cashu": "file:../marketplace-cashu-ts",
    "@sudonym-btc/marketplace-evm": "file:../marketplace-evm-ts",
    "@sudonym-btc/marketplace-location-h3": "file:../marketplace-location-h3-ts",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/router-plugin": "^1.168.38",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.46.0",
    "nostr-tools": "file:../nostr-tools",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-countdown": "^2.3.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-timeago": "^8.3.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.36",
    "@types/node": "26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "1.4.2",
    "shadcn": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
